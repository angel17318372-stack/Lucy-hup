-- LUCY HUB v1.4
-- LocalScript para tu propia experiencia de Roblox.
-- UI, movimiento, protecciones y ajustes.
-- No incluye bypass de anti-cheat ni evasión de detección.

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

local old = pg:FindFirstChild("LucyHub_v14")
if old then old:Destroy() end

local S = {
    speed = false,
    fly = false,
    noclip = false,
    infJump = false,
    antiFling = false,
    walkSpeed = 16,
    flySpeed = 60,
    jumpPower = 50
}

local function char()
    return player.Character or player.CharacterAdded:Wait()
end

local function hum()
    return char():FindFirstChildOfClass("Humanoid")
end

local gui = Instance.new("ScreenGui")
gui.Name = "LucyHub_v14"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = pg

local main = Instance.new("Frame")
main.Size = UDim2.fromOffset(390,500)
main.Position = UDim2.new(.5,-195,.5,-250)
main.BackgroundColor3 = Color3.fromRGB(15,15,22)
main.BorderSizePixel = 0
main.Parent = gui

Instance.new("UICorner",main).CornerRadius = UDim.new(0,18)

local outline = Instance.new("UIStroke",main)
outline.Color = Color3.fromRGB(75,150,255)
outline.Thickness = 2

local header = Instance.new("Frame",main)
header.Size = UDim2.new(1,0,0,72)
header.BackgroundColor3 = Color3.fromRGB(24,23,34)
header.BorderSizePixel = 0

Instance.new("UICorner",header).CornerRadius = UDim.new(0,18)

local title = Instance.new("TextLabel",header)
title.Size = UDim2.new(1,-85,1,0)
title.Position = UDim2.fromOffset(20,0)
title.BackgroundTransparency = 1
title.Text = "LUCY v1.4"
title.TextColor3 = Color3.fromRGB(245,245,255)
title.TextSize = 27
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Left

local close = Instance.new("TextButton",header)
close.Size = UDim2.fromOffset(48,48)
close.Position = UDim2.new(1,-60,0,12)
close.BackgroundColor3 = Color3.fromRGB(35,34,48)
close.Text = "×"
close.TextColor3 = Color3.new(1,1,1)
close.TextSize = 28
close.Font = Enum.Font.GothamBold

Instance.new("UICorner",close).CornerRadius = UDim.new(0,14)

local body = Instance.new("Frame",main)
body.Position = UDim2.fromOffset(12,82)
body.Size = UDim2.new(1,-24,1,-94)
body.BackgroundTransparency = 1

local tabs = Instance.new("Frame",body)
tabs.Size = UDim2.new(1,0,0,42)
tabs.BackgroundTransparency = 1

local content = Instance.new("ScrollingFrame",body)
content.Position = UDim2.fromOffset(0,52)
content.Size = UDim2.new(1,0,1,-52)
content.BackgroundTransparency = 1
content.BorderSizePixel = 0
content.ScrollBarThickness = 4
content.AutomaticCanvasSize = Enum.AutomaticSize.Y

local layout = Instance.new("UIListLayout",content)
layout.Padding = UDim.new(0,9)
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

local pages = {}
local buttons = {}

for _,n in ipairs({"Movimiento","Protecciones","Ajustes","Más"}) do
    pages[n] = {}
end

local function clear()
    for _,x in ipairs(content:GetChildren()) do
        if x:IsA("GuiObject") then
            x:Destroy()
        end
    end
end

local function show(name)
    for n,b in pairs(buttons) do
        b.BackgroundColor3 =
            (n == name)
            and Color3.fromRGB(55,115,205)
            or Color3.fromRGB(28,27,39)
    end

    clear()

    for _,x in ipairs(pages[name]) do
        x.Parent = content
    end
end

local function tab(name,i)
    local b = Instance.new("TextButton",tabs)

    b.Size = UDim2.new(.25,-5,1,0)
    b.Position = UDim2.new((i-1)*.25,0,0,0)
    b.BackgroundColor3 = Color3.fromRGB(28,27,39)
    b.Text = name
    b.TextColor3 = Color3.fromRGB(210,210,225)
    b.TextSize = 12
    b.Font = Enum.Font.GothamSemibold

    Instance.new("UICorner",b).CornerRadius = UDim.new(0,10)

    buttons[name] = b

    b.MouseButton1Click:Connect(function()
        show(name)
    end)
end

for i,n in ipairs({"Movimiento","Protecciones","Ajustes","Más"}) do
    tab(n,i)
end

local function row(text,onStart,fn)
    local r = Instance.new("TextButton")

    r.Size = UDim2.new(1,-6,0,58)
    r.BackgroundColor3 = Color3.fromRGB(24,23,33)
    r.Text = ""
    r.AutoButtonColor = false

    Instance.new("UICorner",r).CornerRadius = UDim.new(0,13)

    local l = Instance.new("TextLabel",r)

    l.Size = UDim2.new(1,-90,1,0)
    l.Position = UDim2.fromOffset(16,0)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Color3.fromRGB(225,225,235)
    l.TextSize = 16
    l.Font = Enum.Font.GothamMedium
    l.TextXAlignment = Enum.TextXAlignment.Left

    local v = Instance.new("TextLabel",r)

    v.Size = UDim2.fromOffset(68,1)
    v.Position = UDim2.new(1,-78,0,0)
    v.BackgroundTransparency = 1
    v.Text = onStart and "ON" or "OFF"
    v.TextColor3 =
        onStart
        and Color3.fromRGB(80,190,120)
        or Color3.fromRGB(165,165,175)
    v.TextSize = 14
    v.Font = Enum.Font.GothamBold

    local on = onStart

    r.MouseButton1Click:Connect(function()
        on = not on

        v.Text = on and "ON" or "OFF"

        v.TextColor3 =
            on
            and Color3.fromRGB(80,190,120)
            or Color3.fromRGB(165,165,175)

        fn(on)
    end)

    return r
end

local function slider(text,min,max,current,fn)

    local h = Instance.new("Frame")

    h.Size = UDim2.new(1,-6,0,76)
    h.BackgroundColor3 = Color3.fromRGB(24,23,33)

    Instance.new("UICorner",h).CornerRadius = UDim.new(0,13)

    local l = Instance.new("TextLabel",h)

    l.Size = UDim2.new(1,-30,0,30)
    l.Position = UDim2.fromOffset(15,7)
    l.BackgroundTransparency = 1
    l.Text = text..": "..current
    l.TextColor3 = Color3.fromRGB(225,225,235)
    l.TextSize = 14
    l.Font = Enum.Font.GothamMedium
    l.TextXAlignment = Enum.TextXAlignment.Left

    local bar = Instance.new("Frame",h)

    bar.Size = UDim2.new(1,-30,0,8)
    bar.Position = UDim2.fromOffset(15,50)
    bar.BackgroundColor3 = Color3.fromRGB(48,47,61)
    bar.BorderSizePixel = 0

    Instance.new("UICorner",bar).CornerRadius = UDim.new(1,0)

    local fill = Instance.new("Frame",bar)

    fill.Size = UDim2.new(
        (current-min)/(max-min),
        0,
        1,
        0
    )

    fill.BackgroundColor3 = Color3.fromRGB(65,135,235)
    fill.BorderSizePixel = 0

    Instance.new("UICorner",fill).CornerRadius = UDim.new(1,0)

    local dragging = false

    local function set(x)

        local p = math.clamp(
            (x-bar.AbsolutePosition.X)
            / bar.AbsoluteSize.X,
            0,
            1
        )

        local val = math.floor(
            min + (max-min)*p
        )

        fill.Size = UDim2.new(p,0,1,0)

        l.Text = text..": "..val

        fn(val)
    end

    bar.InputBegan:Connect(function(i)

        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            set(i.Position.X)

        end
    end)

    UIS.InputChanged:Connect(function(i)

        if dragging
        and (
            i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch
        ) then

            set(i.Position.X)

        end
    end)

    UIS.InputEnded:Connect(function(i)

        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then

            dragging = false

        end
    end)

    return h
end

pages.Movimiento = {

    row("⚡ Velocidad",false,function(on)

        S.speed = on

        local h = hum()

        if h then
            h.WalkSpeed = on and S.walkSpeed or 16
        end

    end),

    slider("Velocidad",16,100,16,function(v)

        S.walkSpeed = v

        if S.speed then

            local h = hum()

            if h then
                h.WalkSpeed = v
            end

        end

    end),

    row("✈️ Fly",false,function(on)
        S.fly = on
    end),

    slider("Fly Speed",20,150,60,function(v)
        S.flySpeed = v
    end),

    row("🧱 Noclip",false,function(on)
        S.noclip = on
    end),

    row("⬆️ Infinite Jump",false,function(on)
        S.infJump = on
    end)
}

pages.Protecciones = {

    row("🛡️ Anti-Fling",false,function(on)
        S.antiFling = on
    end),

    row("🛡️ Anti-Fall",false,function(on)
        S.antiFling = on
    end),

    row("🔄 Restaurar personaje",false,function()

        local h = hum()

        if h then
            h.WalkSpeed = 16
            h.JumpPower = 50
        end

    end)
}

pages.Ajustes = {

    slider("Jump Power",50,150,50,function(v)

        S.jumpPower = v

        local h = hum()

        if h then
            h.JumpPower = v
        end

    end),

    row("📱 Interfaz compacta",false,function(on)

        main.Size =
            on
            and UDim2.fromOffset(340,430)
            or UDim2.fromOffset(390,500)

    end),

    row("🎨 Borde brillante",true,function(on)

        outline.Transparency =
            on and .15 or 1

    end)
}

pages["Más"] = {

    row("🔄 Reiniciar ajustes",false,function()

        S.speed = false
        S.fly = false
        S.noclip = false
        S.infJump = false
        S.walkSpeed = 16
        S.jumpPower = 50

        local h = hum()

        if h then
            h.WalkSpeed = 16
            h.JumpPower = 50
        end

    end)
}

show("Movimiento")

-- Arrastrar el panel desde la parte superior.

do

    local dragging = false
    local start
    local pos

    header.InputBegan:Connect(function(i)

        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            start = i.Position
            pos = main.Position

        end

    end)

    UIS.InputChanged:Connect(function(i)

        if dragging
        and (
            i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch
        ) then

            local d = i.Position-start

            main.Position = UDim2.new(
                pos.X.Scale,
                pos.X.Offset+d.X,
                pos.Y.Scale,
                pos.Y.Offset+d.Y
            )

        end

    end)

    UIS.InputEnded:Connect(function(i)

        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then

            dragging = false

        end

    end)

end

close.MouseButton1Click:Connect(function()
    main.Visible = false
end)

UIS.JumpRequest:Connect(function()

    if S.infJump then

        local h = hum()

        if h then
            h:ChangeState(Enum.HumanoidStateType.Jumping)
        end

    end

end)

RunService.Stepped:Connect(function()

    local c = player.Character

    if c and S.noclip then

        for _,p in ipairs(c:GetDescendants()) do

            if p:IsA("BasePart") then
                p.CanCollide = false
            end

        end

    end

end)

player.CharacterAdded:Connect(function()

    task.wait(.5)

    local h = hum()

    if h then

        h.WalkSpeed =
            S.speed
            and S.walkSpeed
            or 16

        h.JumpPower = S.jumpPower

    end

end)
