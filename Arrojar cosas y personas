        if model.Name == "Part" then
            if (model.Position - hrp.Position).Magnitude <= 20 then
                hrp.Anchored = true
                task.wait(0.02)
                hrp.Anchored = false
            end
        end
    end)
    if antiExplodeCharConn then antiExplodeCharConn:Disconnect() end
