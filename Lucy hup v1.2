local function createTab(text, page)
    local Button = Instance.new("TextButton")

    Button.Size = UDim2.fromOffset(125, 42)
    Button.BackgroundColor3 = BUTTON
    Button.BorderSizePixel = 0
    Button.Text = text
    Button.TextColor3 = SUBTEXT
    Button.Font = Enum.Font.GothamMedium
    Button.TextSize = 14
    Button.Parent = Sidebar

    Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 10)

    TabButtons[page] = Button

    Button.MouseButton1Click:Connect(function()

        for _, p in pairs(Pages) do
            p.Visible = false
        end

        for _, b in pairs(TabButtons) do
            b.BackgroundColor3 = BUTTON
            b.TextColor3 = SUBTEXT
        end

        page.Visible = true
        Button.BackgroundColor3 = Color3.fromRGB(40, 80, 130)
        Button.TextColor3 = TEXT
    end)

    return Button
end

