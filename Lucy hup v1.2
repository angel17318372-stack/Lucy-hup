--------------------------------------------------
-- FLY ENGINE
--------------------------------------------------

local FlyVelocity
local FlyGyro

local function startFly()

    if not Root then
        updateCharacter()
    end

    if FlyVelocity then
        FlyVelocity:Destroy()
    end

    if FlyGyro then
        FlyGyro:Destroy()
    end

    FlyVelocity = Instance.new("BodyVelocity")
    FlyVelocity.Name = "LucyFlyVelocity"
    FlyVelocity.MaxForce =
        Vector3.new(1e9, 1e9, 1e9)
    FlyVelocity.Velocity = Vector3.zero
    FlyVelocity.Parent = Root

    FlyGyro = Instance.new("BodyGyro")
    FlyGyro.Name = "LucyFlyGyro"
    FlyGyro.MaxTorque =
        Vector3.new(1e9, 1e9, 1e9)
    FlyGyro.P = 50000
    FlyGyro.Parent = Root

end

local function stopFly()

    if FlyVelocity then
        FlyVelocity:Destroy()
        FlyVelocity = nil
    end

    if FlyGyro then
        FlyGyro:Destroy()
        FlyGyro = nil
    end

    if Humanoid then
        Humanoid.PlatformStand = false
    end

end

--------------------------------------------------
-- FLY MOVEMENT
--------------------------------------------------

RunService.RenderStepped:Connect(function()

    if Config.Fly and Root and Humanoid then

        if not FlyVelocity then
            startFly()
        end

        local Camera =
            workspace.CurrentCamera

        local move =
            Humanoid.MoveDirection

        local vertical = 0

        -- PC
        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            vertical += 1
        end

        if UIS:IsKeyDown(Enum.KeyCode.LeftControl)
        or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
            vertical -= 1
        end

        -- Mobile:
        -- joystick controla X/Z
        -- botones/Jump permiten vertical

        if Humanoid.Jump then
            vertical += 1
        end

        local velocity =
            move * Config.FlySpeed
            + Vector3.new(
                0,
                vertical * Config.FlySpeed,
                0
            )

        FlyVelocity.Velocity = velocity

        if move.Magnitude > 0.05 then

            FlyGyro.CFrame =
                CFrame.lookAt(
                    Root.Position,
                    Root.Position + move
                )

        end

    else

        if FlyVelocity then
            stopFly()
        end

    end

end)

